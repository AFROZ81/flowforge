<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="flowforge-architecture" name="Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1220" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FlowForge — system architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="560" height="30" as="geometry" />
        </mxCell>

        <mxCell id="client" value="&lt;b&gt;Browser — React 19 SPA&lt;/b&gt;&#10;&#10;src/app — router, providers&#10;src/routes — ProtectedRoute,&#10;PublicRoute guards&#10;src/layouts — AppLayout shell,&#10;sidebar + mobile drawer&#10;src/features — 17 areas:&#10;api, hooks, components, types&#10;src/lib — axios client with the&#10;Bearer interceptor, queryClient,&#10;formatting, theme registry&#10;src/stores — auth (sessionStorage),&#10;ui&#10;TanStack Query cache&#10;PresenceContext — SignalR client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="280" height="266" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;FlowForge.API&lt;/b&gt;&#10;&#10;19 controllers · 89 endpoints&#10;NotificationHub&#10;(/hubs/notifications)&#10;SignalRNotifier&#10;SignalRUserIdProvider&#10;Swagger UI · /health&#10;static files (wwwroot)&#10;&#10;&lt;b&gt;Pipeline, in order:&lt;/b&gt;&#10;CorrelationId&#10;Exception&#10;SecurityHeaders&#10;HttpsRedirection&#10;CORS → localhost:5173&#10;ResponseCompression&#10;Authentication&#10;RateLimiting&#10;Authorization&#10;SerilogRequestLogging&#10;Static files&#10;Controllers · Hub" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="200" width="250" height="371" as="geometry" />
        </mxCell>

        <mxCell id="application" value="&lt;b&gt;FlowForge.Application&lt;/b&gt;&#10;&#10;Features / area / verb&#10;Commands · Queries · Handlers&#10;Validators (FluentValidation)&#10;*Rules — shared invariants&#10;Responses · DTOs · pagination&#10;&#10;&lt;b&gt;Cross-cutting:&lt;/b&gt;&#10;ValidationBehavior&#10;ApiResponse&amp;lt;T&amp;gt; envelope&#10;domain exceptions&#10;&#10;&lt;b&gt;Interfaces it declares:&lt;/b&gt;&#10;IApplicationDbContext&#10;IAuthService · ITokenService&#10;ICurrentUserService&#10;IFileStorageService&#10;IRealtimeNotifier&#10;IOnlineUserTracker&#10;IBoardPresenceTracker&#10;IWorkItemOrderingService&#10;INotificationService&#10;IUserService&#10;IOrganizationService&#10;IWorkItemHistoryService" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="200" width="290" height="431" as="geometry" />
        </mxCell>

        <mxCell id="infrastructure" value="&lt;b&gt;FlowForge.Infrastructure&lt;/b&gt;&#10;&#10;ApplicationDbContext :&#10;IdentityDbContext&amp;lt;&#10;ApplicationUser,&#10;IdentityRole&amp;lt;Guid&amp;gt;, Guid&amp;gt;&#10;13 entity configurations&#10;+ Identity tables&#10;Migrations (git-ignored)&#10;AddInfrastructure()&#10;&#10;&lt;b&gt;Services:&lt;/b&gt;&#10;AuthService · TokenService&#10;CurrentUserService&#10;Organization · User&#10;Notification&#10;WorkItemHistory&#10;WorkItemOrdering&#10;LocalFileStorage&#10;OnlineUserTracker (singleton)&#10;BoardPresenceTracker (singleton)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="200" width="270" height="356" as="geometry" />
        </mxCell>

        <mxCell id="domain" value="&lt;b&gt;FlowForge.Domain&lt;/b&gt;&#10;&#10;&lt;b&gt;13 entities:&lt;/b&gt;&#10;Organization · Project&#10;Board · Column · WorkItem&#10;Comment · Attachment&#10;Label · WorkItemLabel&#10;Notification · ChecklistItem&#10;WorkItemWatcher&#10;WorkItemHistory&#10;&#10;&lt;b&gt;Enums:&lt;/b&gt;&#10;WorkItemStatus&#10;WorkItemPriority&#10;NotificationType&#10;WorkItemHistoryAction&#10;&#10;&lt;b&gt;EntityBase:&lt;/b&gt;&#10;Id · CreatedAt/By&#10;UpdatedAt/By&#10;IsDeleted · DeletedAt&#10;&#10;&lt;i&gt;No dependencies.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1370" y="200" width="260" height="371" as="geometry" />
        </mxCell>

        <mxCell id="sql" value="&lt;b&gt;SQL Server&lt;/b&gt;&#10;FlowForgeDb&#10;12 app tables&#10;+ AspNet* identity tables" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#f5f5f5;strokeColor=#555555;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="700" width="270" height="110" as="geometry" />
        </mxCell>

        <mxCell id="disk" value="&lt;b&gt;Local disk&lt;/b&gt;&#10;Storage/Attachments/&#10;&amp;lt;workItemId&amp;gt;/&amp;lt;guid&amp;gt;&amp;lt;ext&amp;gt;&#10;&lt;i&gt;git-ignored; swap it by&#10;implementing&#10;IFileStorageService&lt;/i&gt;" style="shape=internalStorage;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#555555;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1370" y="700" width="260" height="110" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="REST" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#4a6b8a;exitX=1;exitY=0.229;entryX=0;entryY=0.167;" edge="1" parent="1" source="client" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="SignalR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#4a6b8a;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="client" target="api">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="180" y="160" /><mxPoint x="505" y="160" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="Send()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#2b5f8f;exitX=1;exitY=0.167;entryX=0;entryY=0.143;" edge="1" parent="1" source="api" target="application"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="implements" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#2f7a52;exitX=1;exitY=0.143;entryX=0;entryY=0.171;" edge="1" parent="1" source="application" target="infrastructure"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="maps" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#a2641f;exitX=1;exitY=0.171;entryX=0;entryY=0.167;" edge="1" parent="1" source="infrastructure" target="domain"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="EF Core" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="infrastructure" target="sql"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="FileStream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#555555;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="infrastructure" target="disk">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1283" y="660" /><mxPoint x="1500" y="660" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="rule" value="&lt;b&gt;Dependency rule&lt;/b&gt;&#10;Domain knows nothing. Application depends only on&#10;Domain and declares the interfaces it needs.&#10;Infrastructure implements them. The API composes&#10;everything and holds no business logic." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="520" height="101" as="geometry" />
        </mxCell>

        <mxCell id="flow" value="&lt;b&gt;Request flow&lt;/b&gt;&#10;1 action → 2 IMediator.Send() → 3 ValidationBehavior&#10;runs every IValidator&amp;lt;TRequest&amp;gt; → 4 handler + *Rules&#10;→ 5 EF Core → 6 ApiResponse&amp;lt;T&amp;gt; → 7 ExceptionMiddleware&#10;maps the exception to 400 / 401 / 403 / 404 / 409,&#10;else 500 with the correlation id in traceId." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="880" width="520" height="116" as="geometry" />
        </mxCell>

        <mxCell id="scoping" value="&lt;b&gt;Data scoping&lt;/b&gt;&#10;Every query filters the caller's organizationId claim&#10;(x.Column.Board.Project.OrganizationId). Soft-deleted&#10;rows are filtered by the handlers — there is no global&#10;query filter on the context." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="880" width="470" height="101" as="geometry" />
        </mxCell>

        <mxCell id="rt" value="&lt;b&gt;Realtime&lt;/b&gt;&#10;Groups: user:{id}, organization:{id}, board:{id}. The client&#10;consumes notifications and presence; the WorkItem* and&#10;Comment* broadcasts are sent but have no listener yet." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="520" height="86" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
