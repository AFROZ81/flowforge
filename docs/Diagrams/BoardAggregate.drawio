<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="flowforge-board-aggregate" name="BoardAggregate">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1240" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FlowForge — board and work-item aggregate" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="sub" value="Fields and max lengths from the entities · indexes and delete behaviour from Persistence/Configurations · ordering from WorkItemOrderingService" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#52606d;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1200" height="22" as="geometry" />
        </mxCell>

        <mxCell id="workitem" value="&lt;b&gt;WorkItem  (table WorkItems)&lt;/b&gt;&#10;&#10;Id · ColumnId&#10;Title ≤ 200 · Description? ≤ 2000&#10;Priority : Low | Medium | High | Critical&#10;Status : Active | Completed | Blocked&#10;DisplayOrder : long&#10;DueDate? · ReminderDate?&#10;AssigneeId? (FK AspNetUsers, RESTRICT)&#10;IsArchived = false (default)&#10;&#10;&lt;b&gt;Behaviour on the entity:&lt;/b&gt;&#10;Rename · Edit · MoveToColumn · Reorder&#10;MarkCompleted · MarkBlocked · Activate&#10;Archive · Restore · AssignTo · Unassign&#10;SetReminder · ClearReminder&#10;&#10;&lt;b&gt;Endpoints that write it:&lt;/b&gt;&#10;POST /api/WorkItems&#10;PATCH /{id}/rename · /edit · /move&#10;PATCH /{id}/complete · /block · /activate&#10;PATCH /{id}/archive · /restore&#10;PATCH /{id}/assign/{userId} · /unassign&#10;GET / · /{id} · /column/{columnId}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="110" width="340" height="460" as="geometry" />
        </mxCell>

        <mxCell id="comment" value="&lt;b&gt;Comment  (Comments)&lt;/b&gt;&#10;WorkItemId CASCADE · AuthorId&#10;Content ≤ 4000&#10;IsEdited · EditedAt?&#10;index (WorkItemId, CreatedAt)&#10;index (AuthorId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="110" width="340" height="110" as="geometry" />
        </mxCell>

        <mxCell id="attachment" value="&lt;b&gt;Attachment  (Attachments)&lt;/b&gt;&#10;WorkItemId CASCADE · UploadedById&#10;FileName ≤ 255 · StoredFileName ≤ 255&#10;ContentType ≤ 150 · FileSize&#10;StoragePath ≤ 1000&#10;index (WorkItemId, CreatedAt)&#10;&lt;i&gt;bytes go to disk through&lt;/i&gt;&#10;&lt;i&gt;IFileStorageService; the row&lt;/i&gt;&#10;&lt;i&gt;keeps only the relative path&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="checklist" value="&lt;b&gt;ChecklistItem  (ChecklistItems)&lt;/b&gt;&#10;WorkItemId CASCADE · Title ≤ 500&#10;Order : int · IsCompleted&#10;CompletedAt? · CompletedBy?&#10;index (WorkItemId, Order)&#10;one PATCH reorders" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="340" height="110" as="geometry" />
        </mxCell>

        <mxCell id="history" value="&lt;b&gt;WorkItemHistory  (WorkItemHistories)&lt;/b&gt;&#10;WorkItemId CASCADE · UserId&#10;Action : WorkItemHistoryAction&#10;Description ≤ 1000&#10;index (WorkItemId, CreatedAt)&#10;&lt;i&gt;appended by IWorkItemHistoryService from&lt;/i&gt;&#10;&lt;i&gt;the create, assign, status, comment,&lt;/i&gt;&#10;&lt;i&gt;attachment, label, checklist, watcher and&lt;/i&gt;&#10;&lt;i&gt;reminder handlers&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="110" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="watcher" value="&lt;b&gt;WorkItemWatcher  (WorkItemWatchers)&lt;/b&gt;&#10;WorkItemId CASCADE · UserId&#10;unique (WorkItemId, UserId)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="280" width="340" height="90" as="geometry" />
        </mxCell>

        <mxCell id="wil" value="&lt;b&gt;WorkItemLabel  (join table, own Id)&lt;/b&gt;&#10;WorkItemId CASCADE · LabelId RESTRICT&#10;unique (WorkItemId, LabelId)&#10;Label itself lives in ProjectAggregate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="380" width="340" height="80" as="geometry" />
        </mxCell>

        <mxCell id="notification" value="&lt;b&gt;Notification  (Notifications)&lt;/b&gt;&#10;WorkItemId nullable RESTRICT&#10;RecipientId RESTRICT · OrganizationId CASCADE&#10;Type : NotificationType&#10;Title ≤ 200 · Message ≤ 1000&#10;IsRead · ReadAt?&#10;&lt;i&gt;raised by NotificationService when work is&lt;/i&gt;&#10;&lt;i&gt;assigned, completed, blocked, activated,&lt;/i&gt;&#10;&lt;i&gt;commented on, labelled or given a file&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3eafd;strokeColor=#6b3fa0;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="470" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="column" value="&lt;b&gt;Column  (Columns)&lt;/b&gt; — the parent&#10;Id · BoardId · Name ≤ 100&#10;Description? ≤ 500 · DisplayOrder : int&#10;IsArchived · WorkItems&#10;&lt;i&gt;a new board gets Backlog, To Do,&lt;/i&gt;&#10;&lt;i&gt;In Progress, Review, Done&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="620" y="650" width="340" height="140" as="geometry" />
        </mxCell>

        <mxCell id="reminder" value="&lt;b&gt;A reminder is not an entity&lt;/b&gt;&#10;It is two columns on the item: DueDate plus&#10;ReminderDate. PATCH /api/Reminders upserts&#10;them, DELETE clears both, and GET upcoming /&#10;overdue read them back." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1160" y="670" width="340" height="110" as="geometry" />
        </mxCell>

        <mxCell id="statesTitle" value="Status transitions — explicit endpoints, never implied by which column a card sits in" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2b5f8f;" vertex="1" parent="1">
          <mxGeometry x="60" y="820" width="600" height="24" as="geometry" />
        </mxCell>

        <mxCell id="sActive" value="&lt;b&gt;Active&lt;/b&gt;&#10;set by the constructor" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="860" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="sCompleted" value="&lt;b&gt;Completed&lt;/b&gt;&#10;PATCH /api/WorkItems/{id}/complete" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="860" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sBlocked" value="&lt;b&gt;Blocked&lt;/b&gt;&#10;PATCH /api/WorkItems/{id}/block" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="380" y="950" width="360" height="60" as="geometry" />
        </mxCell>

        <mxCell id="sArchive" value="&lt;b&gt;IsArchived — a flag beside status&lt;/b&gt;&#10;not a state of it&#10;PATCH /{id}/archive · /{id}/restore&#10;An archived item refuses assign,&#10;unassign and edits, and is hidden&#10;until a query asks for it." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="950" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ordering" value="&lt;b&gt;Ordering on a board — WorkItemOrderingService.GetNextDisplayOrderAsync&lt;/b&gt;&#10;• empty column → Gap (1000)&#10;• at the end → last + Gap&#10;• in the middle → the midpoint of its two neighbours&#10;• at the start → first / 2, unless first ≤ Gap&#10;• when the gap between neighbours is ≤ MinimumGap (1), NormalizeColumnAsync&#10;renumbers that whole column at Gap spacing and the calculation repeats&#10;So a drag normally writes one row. Archived and soft-deleted items are&#10;skipped when a column is normalized. Indexes: (ColumnId, DisplayOrder)&#10;and (ColumnId, IsArchived)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="860" width="700" height="176" as="geometry" />
        </mxCell>

        <mxCell id="rulesnote" value="&lt;b&gt;Guards the handlers apply&lt;/b&gt;&#10;WorkItemRules: the item must exist inside the caller's organization, its column&#10;must not be archived, an archived item refuses change, and MarkCompleted /&#10;MarkBlocked / Activate return quietly when already in that state. CommentRules,&#10;AttachmentRules, ChecklistRules, WorkItemWatcherRules, LabelRules,&#10;NotificationRules and ReminderRules follow the same shape." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="1060" width="700" height="116" as="geometry" />
        </mxCell>

        <mxCell id="w1" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#4a6b8a;endArrow=open;endFill=0;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="column" target="workitem"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w2" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=0;exitY=0.12;entryX=1;entryY=0.5;" edge="1" parent="1" source="workitem" target="comment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w3" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=0;exitY=0.435;entryX=1;entryY=0.5;" edge="1" parent="1" source="workitem" target="attachment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w4" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=0;exitY=0.75;entryX=1;entryY=0.5;" edge="1" parent="1" source="workitem" target="checklist"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w5" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=1;exitY=0.174;entryX=0;entryY=0.5;" edge="1" parent="1" source="workitem" target="history"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w6" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=1;exitY=0.522;entryX=0;entryY=0.5;" edge="1" parent="1" source="workitem" target="watcher"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w7" value="1 : 0..* &#10;CASCADE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=1;exitY=0.674;entryX=0;entryY=0.5;" edge="1" parent="1" source="workitem" target="wil"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w8" value="0..1 : 0..* &#10;RESTRICT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#6b3fa0;endArrow=open;endFill=0;exitX=1;exitY=0.956;entryX=0;entryY=0.5;" edge="1" parent="1" source="workitem" target="notification"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w9" value="reminder fields" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#a2641f;endArrow=open;endFill=0;dashed=1;exitX=0.82;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="workitem" target="reminder">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="900" y="640" /><mxPoint x="1330" y="640" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="st1" value="complete" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#2f7a52;endArrow=block;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="sActive" target="sCompleted"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st2" value="block" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#2f7a52;endArrow=block;exitX=0.9;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="sActive" target="sBlocked"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st3" value="activate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#2b5f8f;endArrow=block;dashed=1;exitX=0;exitY=0.85;entryX=1;entryY=0.9;" edge="1" parent="1" source="sCompleted" target="sActive"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="st4" value="activate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#2b5f8f;endArrow=block;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="sBlocked" target="sActive">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="370" y="980" /><mxPoint x="370" y="895" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="st5" value="a blocked item can still be completed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#a2641f;endArrow=block;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="sBlocked" target="sCompleted">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="775" y="980" /><mxPoint x="775" y="890" /></Array>
          </mxGeometry>
        </mxCell>

      </root>
