<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="flowforge-authentication" name="Authentication">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="1420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="FlowForge — bootstrap, registration, sign-in and the per-request path" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1f2933;" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneA" value="0 · Bootstrap — a fresh database has nothing to sign up into" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2b5f8f;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="700" height="24" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="Empty database&#10;no Organization row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="210" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="POST /api/Organizations&#10;anonymous&#10;name · slug · description&#10;CreateOrganizationValidator" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="290" y="120" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="Organization row created&#10;CreatedBy stays null —&#10;TryGetUser() returns null&#10;for an anonymous write" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="GET /api/Organizations/options&#10;anonymous · bare array of&#10;OrganizationOption&#10;(id · name · slug, nothing private)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="870" y="120" width="290" height="100" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="The Workspace select on&#10;the register face now has&#10;something to offer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1200" y="120" width="250" height="100" as="geometry" />
        </mxCell>

        <mxCell id="ea1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ea4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="laneB" value="1 · Registration" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2b5f8f;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="RegisterForm&#10;react-hook-form + Zod&#10;fullName · email · password&#10;confirmPassword&#10;organizationId" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="POST /api/Auth/register&#10;anonymous" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="210" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="RegisterValidator&#10;name 1–100 · email&#10;password ≥ 8&#10;confirm == password&#10;organizationId != Empty" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="570" y="280" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="AuthService.RegisterAsync&#10;organization exists?&#10;else NotFound 404&#10;email taken?&#10;else Conflict 409" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="280" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="UserManager.CreateAsync&#10;policy: 8+, digit, upper,&#10;lower, no symbol required&#10;unique email enforced&#10;ApplicationUser carries&#10;OrganizationId" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="280" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="RegisterResponse&#10;toast: Account created&#10;card flips back to Sign in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="430" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="eb1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="laneC" value="2 · Sign-in" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2b5f8f;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="LoginForm&#10;useLogin (useMutation)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="580" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="POST /api/Auth/login&#10;LoginPolicy limiter:&#10;5 per minute per IP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="280" y="580" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="AuthService.LoginAsync&#10;FindByEmail →&#10;CheckPasswordAsync&#10;either failure gives&#10;Unauthorized 401&#10;Invalid email or password." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="550" y="580" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="TokenService&#10;.GenerateAccessToken&#10;HmacSha256&#10;issuer · audience&#10;expiry 480 minutes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="840" y="580" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="LoginResponse&#10;{ accessToken,&#10;expiresAtUtc }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1130" y="580" width="230" height="120" as="geometry" />
        </mxCell>

        <mxCell id="c6" value="&lt;b&gt;Client stores it and navigates&lt;/b&gt;&#10;auth.store.login(token, expires) → decodeJwtPayload → id, fullName, email, organizationId&#10;isAuthenticated = true · persisted to sessionStorage under the key flowforge-auth&#10;navigate(/dashboard) — ProtectedRoute renders the shell; PublicRoute sends an existing session there&#10;sessionStorage survives a refresh but not a browser restart; logout clears the store" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="740" width="880" height="101" as="geometry" />
        </mxCell>

        <mxCell id="ec1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ec5" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#52606d;labelBackgroundColor=#ffffff;strokeColor=#98a2ad;endArrow=block;exitX=0.5;exitY=1;entryX=0.78;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="laneD" value="3 · Every request afterwards — the token from step 2 rides on each of these" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#2b5f8f;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="lib/api.ts interceptor&#10;Authorization:&#10;Bearer &amp;lt;token&amp;gt;&#10;FormData → Content-Type&#10;is deleted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="940" width="250" height="135" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="PresenceContext&#10;accessTokenFactory →&#10;?access_token=… on&#10;the WebSocket handshake" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eef2f7;strokeColor=#4a6b8a;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="330" y="940" width="230" height="135" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="JwtBearer&#10;issuer · audience ·&#10;key · lifetime&#10;ClockSkew = Zero&#10;OnMessageReceived takes&#10;the query token only&#10;for /hubs/notifications" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2b5f8f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="940" width="280" height="135" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="ICurrentUserService&#10;.User throws when anonymous&#10;or a claim is missing&#10;.TryGetUser() returns null&#10;in the same situations&#10;SignalRUserIdProvider →&#10;nameid → group user:{id}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e9f6ef;strokeColor=#2f7a52;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="940" width="330" height="135" as="geometry" />
        </mxCell>

        <mxCell id="d5" value="&lt;b&gt;Scoping and audit&lt;/b&gt;&#10;Handlers filter by organizationId;&#10;SaveChangesAsync stamps CreatedAt&#10;and UpdatedAt, the By columns from&#10;the claims, IsDeleted = false on insert" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf2e4;strokeColor=#a2641f;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="920" y="1110" width="330" height="101" as="geometry" />
        </mxCell>

        <mxCell id="claims" value="&lt;b&gt;JWT payload&lt;/b&gt;&#10;nameid — user id (NameIdentifier)&#10;name — FullName · email&#10;organizationId — the scoping claim&#10;jti — random id per token&#10;&#10;&lt;b&gt;Header / registration&lt;/b&gt;&#10;alg HS256 · iss FlowForgeAPI&#10;aud FlowForgeClient · exp + 480 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1110" width="380" height="160" as="geometry" />
        </mxCell>

        <mxCell id="notes" value="&lt;b&gt;Worth knowing&lt;/b&gt;&#10;• No refresh token and no revocation list: expiry means signing in again.&#10;• The client decodes the token for display only — the server is the authority on every claim.&#10;• ProtectedRoute / PublicRoute are navigation, not security; the gate is [Authorize] per controller.&#10;• Anonymous surface: register, login, GET and POST /api/Organizations.&#10;• Cookie redirects are converted to 401 / 403 so an API client never follows a login page.&#10;• FluentValidation failures are not mapped by ExceptionMiddleware and surface as 500." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#98a2ad;fontSize=11;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="460" y="1290" width="1000" height="131" as="geometry" />
        </mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#98a2ad;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry" /></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
