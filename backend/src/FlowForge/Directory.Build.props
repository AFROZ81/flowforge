<Project>

  <!--
    Security pin, not a feature dependency.

    Microsoft.EntityFrameworkCore.SqlServer -> Microsoft.Data.SqlClient 6.1.1
    asks for System.Security.Cryptography.Pkcs 9.0.4, which is affected by:
      * CVE-2026-84008 (GHSA-846f-f764-76mx, high)      SignedCms.CheckSignature DoS
      * CVE-2026-70162 (GHSA-2fmv-rv2c-59x7, moderate)  EnvelopedCms.Decode DoS
    Both are fixed in the 10.0.13 line.

    A direct reference always wins over a transitive request, so this lifts
    the resolved assembly in every project under this folder to the patched
    version without moving EF Core or SqlClient themselves. It is safe to
    delete once Microsoft.Data.SqlClient ships a patched transitive — verify
    with:  dotnet nuget why <project> System.Security.Cryptography.Pkcs
  -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
